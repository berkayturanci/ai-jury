    "extra_args": [],
    "argv": ["codex", "exec", "-m", "gpt-probe-1", "-s", "read-only"],
    "write_argv": ["codex", "exec", "-m", "gpt-probe-1", "-s", "workspace-write"],
    "stdin": "prompt",
    "prompt_absent_from_argv": true,
    "sandbox_flags": ["-s", "read-only"],
    "stdout_fixture": "review.stdout"
  },
  "agy": {
