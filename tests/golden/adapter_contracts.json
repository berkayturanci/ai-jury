{
  "_comment": [
    "Locked invocation contract per shipped adapter (issue #682).",
    "Every entry was measured against the real CLI before being written down:",
    "claude -p with the prompt on stdin (#287), codex exec -s read-only (#100),",
    "agy stream-json in/out with the prompt as one NDJSON frame (#635, agy 1.1.22).",
    "A change here is a VENDOR change, not a refactor: update it together with a",
    "CHANGELOG note saying which CLI changed and what was verified against it.",
    "'stdin' is what the adapter feeds the child: 'prompt' verbatim, 'stream-json'",
    "one NDJSON frame carrying it, or 'none' when it goes in argv instead.",
    "'prompt_absent_from_argv' encodes #287: the redacted diff must never be",
    "readable in `ps` to another local user.",
    "The '-bare' entries carry an EMPTY extra_args on purpose: every other spec",
    "here supplies its own sandbox flags, so the sandbox assertion could only",
    "prove they were echoed back. With nothing supplied, the same assertion",
    "proves the adapter ADDS the read-only sandbox itself (#288)."
  ],
  "claude": {
    "vendor": "anthropic",
    "command": "claude",
    "model": "claude-probe-1",
    "extra_args": [
      "--output-format",
      "text",
      "--disallowed-tools",
      "Edit,Write,NotebookEdit,Bash",
      "--dangerously-skip-permissions"
    ],
    "argv": [
      "claude",
      "-p",
      "--model",
      "claude-probe-1",
      "--output-format",
      "text",
      "--disallowed-tools",
      "Edit,Write,NotebookEdit,Bash",
      "--dangerously-skip-permissions"
    ],
    "write_argv": [
      "claude",
      "-p",
      "--model",
      "claude-probe-1",
      "--output-format",
      "text",
      "--dangerously-skip-permissions"
    ],
    "stdin": "prompt",
    "prompt_absent_from_argv": true,
    "sandbox_flags": ["--disallowed-tools"],
    "stdout_fixture": "review.stdout"
  },
  "claude-bare": {
    "vendor": "anthropic",
    "command": "claude",
    "model": "claude-probe-1",
    "extra_args": [],
    "argv": [
      "claude",
      "-p",
      "--model",
      "claude-probe-1",
      "--disallowed-tools",
      "Edit,Write,NotebookEdit,Bash"
    ],
    "write_argv": ["claude", "-p", "--model", "claude-probe-1"],
    "stdin": "prompt",
    "prompt_absent_from_argv": true,
    "sandbox_flags": ["--disallowed-tools", "Edit,Write,NotebookEdit,Bash"],
    "stdout_fixture": "review.stdout"
  },
  "codex": {
    "vendor": "openai",
    "command": "codex",
    "model": "gpt-probe-1",
    "extra_args": ["-s", "read-only"],
    "argv": ["codex", "exec", "-m", "gpt-probe-1", "-s", "read-only"],
    "write_argv": ["codex", "exec", "-m", "gpt-probe-1", "-s", "workspace-write"],
    "stdin": "prompt",
    "prompt_absent_from_argv": true,
    "sandbox_flags": ["-s", "read-only"],
    "stdout_fixture": "review.stdout"
  },
  "codex-bare": {
    "vendor": "openai",
    "command": "codex",
